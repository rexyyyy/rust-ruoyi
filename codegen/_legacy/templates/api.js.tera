import request from '@/utils/request'

// 查询{{ functionName }}列表
export function list{{ clazzName }}(query) {
  return request({
    url: '/{{ moduleName }}/{{ businessName }}/list',
    method: 'get',
    params: query
  })
}

// 查询{{ functionName }}详细
export function get{{ clazzName }}({{ pkColumn }}) {
  return request({
    url: '/{{ moduleName }}/{{ businessName }}/' + {{ pkColumn }},
    method: 'get'
  })
}

// 新增{{ functionName }}
export function add{{ clazzName }}(data) {
  return request({
    url: '/{{ moduleName }}/{{ businessName }}',
    method: 'post',
    data: data
  })
}

// 修改{{ functionName }}
export function update{{ clazzName }}(data) {
  return request({
    url: '/{{ moduleName }}/{{ businessName }}',
    method: 'put',
    data: data
  })
}

// 删除{{ functionName }}
export function del{{ clazzName }}({{ pkColumn }}) {
  return request({
    url: '/{{ moduleName }}/{{ businessName }}/' + {{ pkColumn }},
    method: 'delete'
  })
}
