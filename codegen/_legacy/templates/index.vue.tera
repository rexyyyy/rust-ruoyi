<template>
  <div class="app-container">
    <el-form :model="queryParams" ref="queryRef" :inline="true" v-show="showSearch" label-width="68px">
{% if querycolumns is iterable -%}
    {% for qcolumn in querycolumns -%}
        {% if qcolumn.dicttype == "" -%}
        {% if qcolumn.rtype == "f64" or qcolumn.rtype == "f32" or qcolumn.rtype == "i64" or qcolumn.rtype == "i32" or qcolumn.rtype == "u64" or qcolumn.rtype == "u32" -%}
          <el-form-item label="{{qcolumn.comment}}" prop="{{qcolumn.prop}}">
          <el-input
            type="number" v-model.number="queryParams.{{qcolumn.prop}}"
            placeholder="请输入{{qcolumn.comment}}"
            clearable
            @keyup.enter="handleQuery"
            />
          </el-form-item>
        {% else -%}
          <el-form-item label="{{qcolumn.comment}}" prop="{{qcolumn.prop}}">
          <el-input
            v-model="queryParams.{{qcolumn.prop}}"
            placeholder="请输入{{qcolumn.comment}}"
            clearable
            @keyup.enter="handleQuery"
          />
          </el-form-item>
        {% endif -%}

        {% else -%}
      <el-form-item label="{{qcolumn.comment}}" prop="{{qcolumn.prop}}">
        <el-select v-model="queryParams.{{qcolumn.prop}}" placeholder="请选择{{qcolumn.comment}}" clearable>
          <el-option
            v-for="dict in {{qcolumn.dicttype}}"
            :key="dict.value"
            :label="dict.label"
            :value="dict.value"
          />
        </el-select>
      </el-form-item>

        {% endif -%}
    {% endfor -%}
{% endif -%}

      <el-form-item>
        <el-button type="primary" icon="Search" @click="handleQuery">搜索</el-button>
        <el-button icon="Refresh" @click="resetQuery">重置</el-button>
      </el-form-item>
    </el-form>

    <el-row :gutter="10" class="mb8">
      <el-col :span="1.5">
        <el-button
          type="primary"
          plain
          icon="Plus"
          @click="handleAdd"
          v-hasPermi="['{{moduleName}}:{{businessName}}:add']"
        >新增</el-button>
      </el-col>
      <el-col :span="1.5">
        <el-button
          type="success"
          plain
          icon="Edit"
          :disabled="single"
          @click="handleUpdate"
          v-hasPermi="['{{moduleName}}:{{businessName}}:edit']"
        >修改</el-button>
      </el-col>
      <el-col :span="1.5">
        <el-button
          type="danger"
          plain
          icon="Delete"
          :disabled="multiple"
          @click="handleDelete"
          v-hasPermi="['{{moduleName}}:{{businessName}}:remove']"
        >删除</el-button>
      </el-col>
      <el-col :span="1.5">
        <el-button
          type="warning"
          plain
          icon="Download"
          @click="handleExport"
          v-hasPermi="['{{moduleName}}:{{businessName}}:export']"
        >导出</el-button>
      </el-col>
      <right-toolbar v-model:showSearch="showSearch" @queryTable="getList"></right-toolbar>
    </el-row>

    <el-table v-loading="loading" :data="{{businessName}}List" @selection-change="handleSelectionChange">
      <el-table-column type="selection" width="55" align="center" />
{% if columns is iterable %}
    {% for qcolumn in columns %}
        {% if qcolumn.pk -%}
      <el-table-column label="{{qcolumn.comment}}" align="center" prop="{{qcolumn.prop}}" />
        {% elif qcolumn.htmltype == "datetime" -%}
      <el-table-column label="{{qcolumn.comment}}" align="center" prop="{{qcolumn.prop}}" width="180">
        <template #default="scope">
          <span>{  parseTime(scope.row.{{qcolumn.prop}}, '{y}-{m}-{d}')  }</span>
        </template>
      </el-table-column>
        {% elif qcolumn.htmltype == "imageUpload" -%}
      <el-table-column label="{{qcolumn.comment}}" align="center" prop="{{qcolumn.prop}}" width="100">
        <template #default="scope">
          <image-preview :src="scope.row.{{qcolumn.prop}}" :width="50" :height="50"/>
        </template>
      </el-table-column>
        {% elif qcolumn.dicttype != "" -%}
      <el-table-column label="{{qcolumn.comment}}" align="center" prop="{{qcolumn.prop}}">
        <template #default="scope">

          {% if qcolumn.htmltype == "checkbox" -%}
          <dict-tag :options="{{qcolumn.dicttype}}" :value="scope.row.{{qcolumn.prop}} ? scope.row.{{qcolumn.prop}}.split(',') : []"/>
          {% else -%}
          <dict-tag :options="{{qcolumn.dicttype}}" :value="scope.row.{{qcolumn.prop}}"/>
          {% endif %}
        </template>
      </el-table-column>
        {% else -%}
      <el-table-column label="{{qcolumn.comment}}" align="center" prop="{{qcolumn.prop}}" />
     

        {% endif %}
    {% endfor %}
{% endif %}

      <el-table-column label="操作" align="center" class-name="small-padding fixed-width">
        <template #default="scope">
          <el-button link type="primary" icon="Edit" @click="handleUpdate(scope.row)" v-hasPermi="['{{moduleName}}:{{businessName}}:edit']">修改</el-button>
          <el-button link type="primary" icon="Delete" @click="handleDelete(scope.row)" v-hasPermi="['{{moduleName}}:{{businessName}}:remove']">删除</el-button>
        </template>
      </el-table-column>
    </el-table>
    
    <pagination
      v-show="total>0"
      :total="total"
      v-model:page="queryParams.pageNum"
      v-model:limit="queryParams.pageSize"
      @pagination="getList"
    />

    <!-- 添加或修改{{functionName}}对话框 -->
    <el-dialog :title="title" v-model="open" width="500px" append-to-body>
      <el-form ref="{{businessName}}Ref" :model="form" :rules="rules" label-width="80px">
{% if columns is iterable %}
    {% for column in columns %}
        {% if column.htmltype == "input" %}
        <el-form-item label="{{column.comment}}" prop="{{column.prop}}">
          
          {% if column.rtype == "f64" or column.rtype == "f32" or column.rtype == "i64" or column.rtype == "i32" or column.rtype == "u64" or column.rtype == "u32" %}
              <el-input type="number" v-model.number="form.{{column.prop}}" placeholder="请输入{{column.comment}}" />
          {% else %}
              <el-input v-model="form.{{column.prop}}" placeholder="请输入{{column.comment}}" />
          {% endif %}
        </el-form-item>
        {% elif column.htmltype == "imageUpload" -%}
        <el-form-item label="{{column.comment}}" prop="{{column.prop}}">
          <image-upload v-model="form.{{column.prop}}"/>
        </el-form-item>
        {% elif column.htmltype == "fileUpload" -%}
        <el-form-item label="{{column.comment}}" prop="{{column.prop}}">
          <file-upload v-model="form.{{column.prop}}"/>
        </el-form-item>
        {% elif column.htmltype == "editor" -%}
        <el-form-item label="{{column.comment}}">
          <editor v-model="form.{{column.prop}}" :min-height="192"/>
        </el-form-item>
        {% elif column.htmltype == "select" and column.dicttype != "" -%}
        <el-form-item label="{{column.comment}}" prop="{{column.prop}}">
          <el-select v-model="form.{{column.prop}}" placeholder="请选择{{column.comment}}">
            <el-option
              v-for="dict in {{column.dicttype}}"
              :key="dict.value"
              :label="dict.label"
          {% if column.rtype == "i64" or column.rtype == "i32" or column.rtype == "u64" or column.rtype == "u32" %}
              :value="parseInt(dict.value)"
          {% else %}
              :value="dict.value"
          {% endif %}
            ></el-option>
          </el-select>
        </el-form-item>
        {% elif column.htmltype == "select" and column.dicttype == "" -%}
        <el-form-item label="{{column.comment}}" prop="{{column.prop}}">
          <el-select v-model="form.{{column.prop}}" placeholder="请选择{{column.comment}}">
            <el-option label="请选择字典生成" value="" />
          </el-select>
        </el-form-item>
        {% elif column.htmltype == "checkbox" and column.dicttype != "" -%}
        <el-form-item label="{{column.comment}}" prop="{{column.prop}}">
          <el-checkbox-group v-model="form.{{column.prop}}">
            <el-checkbox
              v-for="dict in {{column.dicttype}}"
              :key="dict.value"
              :label="dict.value">
              { dict.label }
            </el-checkbox>
          </el-checkbox-group>
        </el-form-item>
        {% elif column.htmltype == "checkbox" and column.dicttype == "" -%}
        <el-form-item label="{{column.comment}}" prop="{{column.prop}}">
          <el-checkbox-group v-model="form.{{column.prop}}">
            <el-checkbox>请选择字典生成</el-checkbox>
          </el-checkbox-group>
        </el-form-item>
        {% elif column.htmltype == "radio" and column.dicttype != "" -%}
        <el-form-item label="{{column.comment}}" prop="{{column.prop}}">
          <el-radio-group v-model="form.{{column.prop}}">
            <el-radio
              v-for="dict in {{column.dicttype}}"
              :key="dict.value"
          {% if column.rtype == "i64" or column.rtype == "i32" or column.rtype == "u64" or column.rtype == "u32" %}
              :label="parseInt(dict.value)"
          {% else -%}
              :label="dict.value"
          {% endif -%}
            >{ dict.label }</el-radio>
          </el-radio-group>
        </el-form-item>
        {% elif column.htmltype == "radio" and column.dicttype == "" -%}
        <el-form-item label="{{column.comment}}" prop="{{column.prop}}">
          <el-radio-group v-model="form.{{column.prop}}}">
            <el-radio label="1">请选择字典生成</el-radio>
          </el-radio-group>
        </el-form-item>
        {% elif column.htmltype == "datetime" -%}
        <el-form-item label="{{column.comment}}" prop="{{column.prop}}">
          <el-date-picker clearable
            v-model="form.{{column.prop}}"
            type="date"
            value-format="YYYY-MM-DD"
            placeholder="请选择{{column.comment}}">
          </el-date-picker>
        </el-form-item>
        {% elif column.htmltype == "textarea"  -%}
        <el-form-item label="{{column.comment}}" prop="{{column.prop}}">
          <el-input v-model="form.{{column.prop}}" type="textarea" placeholder="请输入内容" />
        </el-form-item>

        {% else -%}
        <el-form-item label="{{column.comment}}" prop="{{column.prop}}">
          {% if column.rtype == "f64" or column.rtype == "f32" or column.rtype == "i64" or column.rtype == "i32" or column.rtype == "u64" or column.rtype == "u32" %}
              <el-input type="number" v-model.number="form.{{column.prop}}" placeholder="请输入{{column.comment}}" />
          {% else %}
              <el-input v-model="form.{{column.prop}}" placeholder="请输入{{column.comment}}" />
          {% endif %}
        </el-form-item>
        {% endif -%}
    {% endfor -%}
{% endif %}
<!-- form end  -->
      </el-form>
      <template #footer>
        <div class="dialog-footer">
          <el-button type="primary" @click="submitForm">确 定</el-button>
          <el-button @click="cancel">取 消</el-button>
        </div>
      </template>
    </el-dialog>
  </div>
</template>

<script setup name="{{businessName}}">
import { list{{clazzName}}, get{{clazzName}}, del{{clazzName}}, add{{clazzName}}, update{{clazzName}} } from "@/api/{{moduleName}}/{{jsfileName}}";

const { proxy } = getCurrentInstance();
{% if dicts != "" -%}
const { {{ dicts | replace(from="'", to="") }} } = proxy.useDict({{dicts}} );
{% endif -%}

const {{businessName}}List = ref([]);
const open = ref(false);
const loading = ref(true);
const showSearch = ref(true);
const ids = ref([]);

const single = ref(true);
const multiple = ref(true);
const total = ref(0);
const title = ref("");
const dateRange = ref([]); 
// 日期范围查询

const data = reactive({
  form: {},
  queryParams: {
    pageNum: 1,
    pageSize: 10,
{% if querycolumns is iterable -%}
    {% for qcolumn in querycolumns -%}
    {{qcolumn.prop}}: null,
    {% endfor -%}
{% endif %}
  },
  rules: {
{% if columns is iterable -%}
    {% for column in columns -%}
          {% if column.htmltype == "select" or column.htmltype == "radio" -%}
    {{column.prop}}: [{ required: true, message: "{{column.comment}}不能为空", trigger: "change" }],
          {% elif column.nullable -%}
    {{column.prop}}: [{ required: true,message: "{{column.comment}}不能为空", trigger: "change" }],
          {% else -%}
    
          {% endif -%}
    {% endfor -%}
{% endif -%}
  }
});

const { queryParams, form, rules } = toRefs(data);

/** 查询{{functionName}}列表 */
function getList() {
  loading.value = true;
{% for qcolumn in querycolumns -%}
{% if qcolumn.htmltype == "datetime" or qcolumn.querytype == "BETWEEN" -%} queryParams.value.params = {}; {% endif -%}
{% endfor -%}

  // queryParams.value.params["begin${AttrName}"] = daterange${AttrName}.value[0];
  // queryParams.value.params["end${AttrName}"] = daterange${AttrName}.value[1];

  list{{clazzName}}(queryParams.value).then(response => {
    {{businessName}}List.value = response.rows;
    total.value = response.total;
    loading.value = false;
  });
}

// 取消按钮
function cancel() {
  open.value = false;
  reset();
}

// 表单重置
function reset() {
  form.value = {
{% for column in columns -%}
  {% if column.htmltype == "checkbox" -%}

    {{column.prop}}: [],
  {% else -%}
    {{column.prop}}: null,
  {% endif -%}
{% endfor -%}
  };
  proxy.resetForm("{{businessName}}Ref");
}

/** 搜索按钮操作 */
function handleQuery() {
  queryParams.value.pageNum = 1;
  getList();
}

/** 重置按钮操作 */
function resetQuery() {
{% for qcolumn in querycolumns -%}
  {% if qcolumn.htmltype == "datetime" and qcolumn.queryType == "BETWEEN" -%}
  daterange{{qcolumn.prop}}.value = [];
  {% endif -%}
{% endfor %}
  dateRange.value = [];
  proxy.resetForm("queryRef");
  handleQuery();
}

// 多选框选中数据
function handleSelectionChange(selection) {
  ids.value = selection.map(item => item.{{pkColumn}});
  single.value = selection.length != 1;
  multiple.value = !selection.length;
}

/** 新增按钮操作 */
function handleAdd() {
  reset();
  open.value = true;
  title.value = "添加 {{functionName}} ";
}

/** 修改按钮操作 */
function handleUpdate(row) {
  reset();
  const _{{pkColumn}} = row.{{pkColumn}} || ids.value
  get{{clazzName}}(_{{pkColumn}}).then(response => {
    form.value = response.data;
{% for column in columns -%}
  {% if column.htmltype == "checkbox"   -%}
    form.value.{{column.prop}} = form.value.{{column.prop}}.split(",");
  {% endif -%}
{% endfor -%}
    open.value = true;
    title.value = "修改 {{functionName}} ";
  });
}

/** 提交按钮 */
function submitForm() {
  proxy.$refs["{{businessName}}Ref"].validate(valid => {
    if (valid) {
{% for column in columns -%}
  {% if column.htmltype == "checkbox" -%}
      form.value.{{column.prop}} = form.value.{{column.prop}}.join(",");
  {% endif -%}
{% endfor -%}
{% for column in columns -%}
          {% if column.rtype == "f64" or column.rtype == "f32" or column.rtype == "i64" or column.rtype == "i32" or column.rtype == "u64" or column.rtype == "u32" %}
      if(form.value.{{column.prop}}!=null || form.value.{{column.prop}}!==undefined){ //数字类型的转换
        form.value.{{column.prop}}=Number(0)
      }else{
        form.value.{{column.prop}}=Number(form.value.{{column.prop}}+'')
      }
          {% endif -%}
{% endfor -%}

      if (form.value.{{pkColumn}} != null) {
        update{{clazzName}}(form.value).then(response => {
          proxy.$modal.msgSuccess("修改成功");
          open.value = false;
          getList();
        });
      } else {
        add{{clazzName}}(form.value).then(response => {
          proxy.$modal.msgSuccess("新增成功");
          open.value = false;
          getList();
        });
      }
    }
  });
}

/** 删除按钮操作 */
function handleDelete(row) {
  const _{{pkColumn}}s = row.{{pkColumn}} || ids.value;
  proxy.$modal.confirm('是否确认删除{{functionName}} 编号为"' + _{{pkColumn}}s + '"的数据项？').then(function() {
    return del{{clazzName}}(_{{pkColumn}}s);
  }).then(() => {
    getList();
    proxy.$modal.msgSuccess("删除成功");
  }).catch(() => {});
}

/** 导出按钮操作 */
function handleExport() {
  proxy.download('{{moduleName}}/{{businessName}}/export', {
    ...queryParams.value
  }, `{{businessName}}_#[[${new Date().getTime()}]]#.xlsx`)
}
/** 刷新缓存按钮操作 */
function handleRefreshCache() {
  //refreshCache().then(() => {
  //  proxy.$modal.msgSuccess("刷新缓存成功");
  //});
}

getList();
</script>
