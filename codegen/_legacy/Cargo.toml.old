[package]
name = "codegen"
version = "0.1.0"
edition = "2021"

[[bin]]
name = "codegen"
path = "src/main.rs"

[features]
default = ["postgresql","tls-rustls"]
postgresql = []
tls-rustls=["rbdc/tls-rustls"]
tls-native-tls=["rbdc/tls-native-tls"]

[dependencies]
actix-web = "4.9.0"
actix = "0.13.5"
validator ={ version = "0.18", features = ["derive"] }#加入验证框架 "0.18.1"

tokio = { version = "1", features = ["full"] }
tokio-util = "0.7.12"
tokio-stream = "0.1.16"
once_cell = "1.20.2"
lazy_static = "1.4"

# bcrypt = "0.15.1" # 由于 bcrypt 加密运行比较慢 已用 下面 rust-crypto 替换
rust-crypto = "0.2.36"

async-std = "1.13.0"

serde = "1.0.210"
serde_json = "1.0.128"
serde_yaml = "0.9.34"
merge-yaml-hash = "0.4.0"

rbs = { version = "4.6"}
rbdc = { version = "4.6", default-features = false,  optional = true }
rbdc-pg = {version="4.6"}
# rbatis = { version = "4.6",features = ["debug_mode"]}
rbatis = { version = "4.6"}

fastdate = { version = "0.3" }
redis = "0.28.1"
uuid = "1.10.0"

user-agent-parser = "0.3.6"
base64 = "0.22.1"
bytesize = "1.3.0"

log = "0.4.22"
fast_log = "1.7.4"

sysinfo = "0.28.2"
Inflector = "0.11.4"
tera ={ version = "1.20.0", default-features = false } #"1.20.0"
chrono = "0.4.40"
