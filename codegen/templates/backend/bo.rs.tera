            {{ pk.column_name }}: arg.{{ pk.column_name }}.unwrap_or_default(),
{% for c in columns %}{% if not c.is_pk %}{% if c.field == "update_time" and c.now_expr != "" %}            {{ c.field }}: Some({{ c.now_expr }}),
{% elif c.is_edit %}            {{ c.field }}: arg.{{ c.field }},
{% else %}            {{ c.field }}: None,
{% endif %}{% endif %}{% endfor %}        }
    }
}
