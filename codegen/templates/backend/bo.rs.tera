{% if pk.rust_type != "String" %}/// 兼容前端回传的雪花 ID：字符串 / 整数 / 浮点（JS Number）/ null 四种 JSON 形态均可
fn string_or_number<'de, D>(deserializer: D) -> Result<Option<{{ pk.rust_type }}>, D::Error>
where
    D: serde::Deserializer<'de>,
{
    use serde::Deserialize;
    #[derive(Deserialize)]
    #[serde(untagged)]
    enum V {
        S(String),
        I({{ pk.rust_type }}),
        F(f64),
    }
    match Option::<V>::deserialize(deserializer)? {
        None => Ok(None),
        Some(V::S(s)) => s.parse().map(Some).map_err(serde::de::Error::custom),
        Some(V::I(i)) => Ok(Some(i)),
        Some(V::F(f)) => Ok(Some(f as {{ pk.rust_type }})),
    }
}
{% endif %}
/// 修改参数
#[derive(Serialize, Deserialize, Clone, Debug)]
#[serde(rename_all = "camelCase")]
pub struct {{ class_name }}UpdateDTO {
{% if pk.rust_type != "String" %}    // VO 主键输出为 String（防 JS 精度丢失），前端会原样回传，
    // 因此主键同时接受字符串与数字两种 JSON 形态
    #[serde(deserialize_with = "string_or_number")]
{% endif %}    pub {{ pk.column_name }}: Option<{{ pk.rust_type }}>,
{% for c in columns %}{% if c.is_edit and not c.is_pk %}    pub {{ c.field }}: Option<{{ c.rust_type }}>, // {{ c.comment }}
{% endif %}{% endfor %}}

